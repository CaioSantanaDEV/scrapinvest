{
  "buildCommand": "npm run build",
  "outputDirectory": "frontend/dist/scrapinvest-frontend/browser",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://scrapinvest-backend.onrender.com/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
